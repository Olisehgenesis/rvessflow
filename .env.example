# Copy to .env and fill in. Never commit .env or a real private key.
PRIVATE_KEY=
# Optional. The vault owner can trigger keeper-gated flows without this.
KEEPER=
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Public WalletConnect project id. It is meant to ship in the browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# MotherDuck service token. The contact directory lives in this database.
MOTHERDUCK_TOKEN=
MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
MOTHERDUCK_DB=beta
