# Copy to .env and fill in. Never commit .env or a real private key.
PRIVATE_KEY=
# Optional. The vault owner can trigger keeper-gated flows without this.
KEEPER=
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Public WalletConnect project id. It is meant to ship in the browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# MotherDuck service token. The contact directory lives in this database.
MOTHERDUCK_TOKEN=
MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
MOTHERDUCK_DB=beta
# Optional funding providers. Leave blank to show the not-configured state.
# Kotani Pay: Uganda MTN MoMo / Airtel Money -> USDC on Base.
KOTANI_API_KEY=
KOTANI_API_BASE=https://sandbox-api.kotanipay.com
KOTANI_CALLBACK_URL=
# Transak widget session (server). NEXT_PUBLIC_TRANSAK_API_KEY is accepted as the widget key.
TRANSAK_API_KEY=
NEXT_PUBLIC_TRANSAK_API_KEY=
TRANSAK_ACCESS_TOKEN=
TRANSAK_REFERRER_DOMAIN=
TRANSAK_ENV=
# Coinbase Onramp session token (CDP secret API key, server only).
COINBASE_CDP_API_KEY_NAME=
COINBASE_CDP_API_KEY_SECRET=
COINBASE_PROJECT_ID=
COINBASE_ONRAMP_REDIRECT_URL=
