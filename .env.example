# Copy to .env and fill in, then `dotenvx encrypt`. Never commit .env.keys or a real private key.
# npm scripts decrypt at process start: dotenvx run --convention=nextjs -- <command>
# Locally dotenvx reads .env.keys. On Vercel, platform env is already injected; missing .env files are ignored.
PRIVATE_KEY=
# Optional. Celo CELO for passkeys when GoodDollar's faucet cannot (Kernel rejects their 2300-gas transfer).
CELO_TOP_KEY=
# Optional. The vault owner can trigger keeper-gated flows without this.
KEEPER=
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CELO_RPC_URL=https://rpc.ankr.com/celo
# Celo protocol signed 29 Oct 2026. Public contract addresses. G$ is on the allowlist.
CELO_ALLOWLIST=0xfc48D9CaeBb63Ac94D1170E921E126d9722B6C4E
CELO_FACTORY=0x0060f57E447e5E2D310b61cAD372Ae83959aF3B7
CELO_LOCKS=0x0A55056218036f3396b00115e44569eb7D33e951
CELO_GROUPS=0xc9c9483ab7BB269Ce50Ff265A5b0583268e39F63
# App network: base, sepolia, or celo. A command argument overrides this file.
# npm run dev -- sepolia
# npm run dev -- celo
# npm run build -- base
RVESS_NETWORK=base
NEXT_PUBLIC_RVESS_NETWORK=base
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CELO_RPC_URL=https://rpc.ankr.com/celo
# Server-only. Celo passkey bundler and verifying paymaster. Never NEXT_PUBLIC_.
PIMLICO_API_KEY=
PIMLICO_SPONSORSHIP_POLICY_ID=sp_small_tusk
PIMLICO_WEBHOOK_SECRET=
# Public WalletConnect project id. It is meant to ship in the browser.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# MotherDuck service token. The contact directory lives in this database.
MOTHERDUCK_TOKEN=
MOTHERDUCK_HOST=pg.us-east-1-aws.motherduck.com
MOTHERDUCK_DB=beta
# Optional funding providers. Leave blank to show the not-configured state.
# Fonbnk Pay Widget: mobile money / bank on-ramp and off-ramp. Source is the merchant id.
FONBNK_SOURCE=6a1063bce738a4967b21f557
FONBNK_URL_SECRET=
FONBNK_ENV=
# Kotani Pay: Uganda MTN MoMo / Airtel Money -> USDC on Base.
KOTANI_API_KEY=
KOTANI_API_BASE=https://sandbox-api.kotanipay.com
KOTANI_CALLBACK_URL=
# Transak widget session (server). NEXT_PUBLIC_TRANSAK_API_KEY is accepted as the widget key.
TRANSAK_API_KEY=
NEXT_PUBLIC_TRANSAK_API_KEY=
TRANSAK_ACCESS_TOKEN=
TRANSAK_REFERRER_DOMAIN=
TRANSAK_ENV=
# Coinbase Onramp session token (CDP secret API key, server only).
COINBASE_CDP_API_KEY_NAME=
COINBASE_CDP_API_KEY_SECRET=
COINBASE_PROJECT_ID=
COINBASE_ONRAMP_REDIRECT_URL=
# PostHog browser analytics. Use the public project token and ingestion host.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
# Optional. Set to 1 to print PostHog debug logs in the browser.
NEXT_PUBLIC_POSTHOG_DEBUG=
